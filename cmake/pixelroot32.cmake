function(especter_pixelroot32_sources out_var pr32_dir for_native)
    file(GLOB_RECURSE found "${pr32_dir}/src/*.cpp")
    set(filtered "")
    foreach(source ${found})
        if(source MATCHES "/drivers/esp32/")
            continue()
        endif()
        if(source MATCHES "/audio/")
            continue()
        endif()
        if(NOT for_native AND source MATCHES "/drivers/native/")
            continue()
        endif()
        if(for_native AND source MATCHES "/drivers/native/" AND NOT source MATCHES "SDL2_Drawer\\.cpp$")
            continue()
        endif()
        list(APPEND filtered "${source}")
    endforeach()
    set(${out_var} ${filtered} PARENT_SCOPE)
endfunction()
